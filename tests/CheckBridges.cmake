execute_process(COMMAND ${PYTHON} ${GENERATOR} libc -o ${OUTPUT} RESULT_VARIABLE generated)
if(NOT generated EQUAL 0)
    message(FATAL_ERROR "The bridge generator failed for libc")
endif()
file(STRINGS ${OUTPUT} puts REGEX "ps5lift_import_YQ0navp_pYIc")
if(NOT puts)
    message(FATAL_ERROR "The libc bridges have no bridge for puts (YQ0navp+YIc)")
endif()
execute_process(COMMAND ${COMPILER} --target=${TRIPLE} -std=c++20 -fsyntax-only -I${INCLUDE} ${OUTPUT} RESULT_VARIABLE compiled)
if(NOT compiled EQUAL 0)
    message(FATAL_ERROR "The generated libc bridges do not compile for ${TRIPLE}")
endif()
