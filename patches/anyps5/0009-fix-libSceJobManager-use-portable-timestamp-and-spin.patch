From 95d0af6c7000a0e80ea9184723a1bae64c64354d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 28 Oct 2026 13:53:59 +0000
Subject: [PATCH 09/12] fix(libSceJobManager): use portable timestamp and spin
 pause

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015taLuK6Ak1pT1P849L2eqq
---
 core/libs/prx/libSceJobManager/Export.cpp | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/core/libs/prx/libSceJobManager/Export.cpp b/core/libs/prx/libSceJobManager/Export.cpp
index 7c6a8d77d..948b0da9c 100644
--- a/core/libs/prx/libSceJobManager/Export.cpp
+++ b/core/libs/prx/libSceJobManager/Export.cpp
@@ -20,7 +20,8 @@
 #include <cstdint>
 #include <cstdio>
 #include <cstring>
-#include <immintrin.h>
+#include "prx/libc/include/GuestCpu.hpp"
+#include "prx/libc/include/PreciseWait.hpp"
 #include <memory>
 #include <mutex>
 #include <span>
@@ -816,17 +817,17 @@ bool RunOne(Manager& manager, std::unique_lock<std::mutex>& guard) {
 void* APS5_VABI WorkerEntry(void* argument) {
     Manager& manager = *static_cast<Manager*>(argument);
     currentWorker = &manager;
-    std::uint64_t lastWork = __rdtsc();
+    std::uint64_t lastWork = GuestCpu::ReadTsc();
     std::unique_lock guard(manager.lock);
     while (manager.running) {
         if (RunOne(manager, guard)) {
-            lastWork = __rdtsc();
+            lastWork = GuestCpu::ReadTsc();
             continue;
         }
-        const bool spinning = manager.pendingInvocations != 0 && __rdtsc() - lastWork < manager.spinTicks;
+        const bool spinning = manager.pendingInvocations != 0 && GuestCpu::ReadTsc() - lastWork < manager.spinTicks;
         if (spinning || manager.sleepingWorkers >= manager.workerCount - manager.persistentThreads) {
             guard.unlock();
-            _mm_pause();
+            PreciseSpinPause();
             guard.lock();
             continue;
         }
