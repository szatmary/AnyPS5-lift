+    GuestCpu::SetX87Status(static_cast<std::uint16_t>((GuestCpu::X87Status() & ~mask) | (flags & mask)));
+    GuestCpu::SetMxcsr((GuestCpu::Mxcsr() & ~mask) | (flags & mask));
