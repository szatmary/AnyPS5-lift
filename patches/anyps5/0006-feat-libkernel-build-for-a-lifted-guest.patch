 inline void X87Wait() { GuestCpuX87Wait_nid_no_patch(); }
 inline std::uint32_t MxcsrMask() { return GuestCpuMxcsrMask_nid_no_patch(); }
+inline std::uint64_t ReadTsc() { return GuestCpuReadTsc_nid_no_patch(); }
 
