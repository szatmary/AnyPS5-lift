diff --git a/core/libs/prx/libkernel/SyncOnAddress/src/SyncOnAddress.cpp b/core/libs/prx/libkernel/SyncOnAddress/src/SyncOnAddress.cpp
index 358c534ba..f4430c6a3 100644
--- a/core/libs/prx/libkernel/SyncOnAddress/src/SyncOnAddress.cpp
+++ b/core/libs/prx/libkernel/SyncOnAddress/src/SyncOnAddress.cpp
@@ -2,6 +2,7 @@
 #include "prx/libc/include/Api.hpp"
 #include <array>
 #include <atomic>
+#include <cstring>
 #include <chrono>
 #include <cstdint>
 #include <limits>
@@ -134,7 +135,13 @@ template <class TValue>
 TValue LoadAddressValue(TValue* address) {
     if (reinterpret_cast<std::uintptr_t>(address) % alignof(TValue) == 0) return std::atomic_ref<TValue>(*address).load();
     TValue value;
+#ifdef ANYPS5_GUEST_LIFTED
+    std::atomic_signal_fence(std::memory_order_seq_cst);
+    std::memcpy(&value, address, sizeof(value));
+    std::atomic_signal_fence(std::memory_order_seq_cst);
+#else
     asm volatile("mov %1, %0" : "=r"(value) : "m"(*reinterpret_cast<const unsigned char (*)[sizeof(TValue)]>(address)));
+#endif
     return value;
 }
 
