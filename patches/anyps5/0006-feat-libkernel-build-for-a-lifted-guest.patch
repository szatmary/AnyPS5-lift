     return {0xffff0000u | X87Control(), 0xffff0000u | X87Status(), 0xffffffffu, 0, 0, 0, 0xffff0000u};
@@ -46,10 +51,13 @@ inline void SetX87Environment(const std::array<std::uint32_t, 7>& environment) {
 
 #else
 
+#include <x86intrin.h>
 #include <xmmintrin.h>
 
