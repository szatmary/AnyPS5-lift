     const Json* Find(std::string_view key) const;
     bool IsTrue() const;
@@ -41,6 +43,11 @@ public:
     std::optional<std::int32_t> Id() const;
 };
 
+struct JsonMember {
+    std::string first;
+    Json second;
+};
+
