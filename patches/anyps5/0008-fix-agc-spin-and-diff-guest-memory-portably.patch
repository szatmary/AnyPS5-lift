From 80027559da101a0f75172d4a2ca309acee40b1ea Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 28 Oct 2026 13:39:31 +0000
Subject: [PATCH 08/10] fix(agc): spin and diff guest memory portably

Spin loops in the driver yield through PreciseSpinPause, which now uses
the aarch64 yield hint, on every architecture, and WriteChanged falls
back to its byte loop where SSE2 is not available.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015taLuK6Ak1pT1P849L2eqq
---
 .../prx/libSceAgcDriver/Execution/include/HandoffSpin.hpp | 8 ++------
 .../Execution/src/Driver/Synchronization/WaitMemory.cpp   | 4 ++--
 .../prx/libSceAgcDriver/Execution/src/GuestMemory.cpp     | 4 ++++
 .../prx/libSceAgcDriver/Graphics/include/SlimMutex.hpp    | 8 ++------
 core/libs/prx/libc/include/PreciseWait.hpp                | 2 ++
 5 files changed, 12 insertions(+), 14 deletions(-)

diff --git a/core/libs/prx/libSceAgcDriver/Execution/include/HandoffSpin.hpp b/core/libs/prx/libSceAgcDriver/Execution/include/HandoffSpin.hpp
index 6c4b8213e..2ef14ecee 100644
--- a/core/libs/prx/libSceAgcDriver/Execution/include/HandoffSpin.hpp
+++ b/core/libs/prx/libSceAgcDriver/Execution/include/HandoffSpin.hpp
@@ -8,16 +8,12 @@
 #include <cstdint>
 #include <cstdlib>
 #include <thread>
-#if defined(__x86_64__) || defined(_M_X64)
-#include <immintrin.h>
-#endif
+#include "prx/libc/include/PreciseWait.hpp"
 
 namespace AgcDriver {
 
 inline void SpinPause() {
-#if defined(__x86_64__) || defined(_M_X64)
-    _mm_pause();
-#endif
+    PreciseSpinPause();
 }
 
 inline unsigned UsableProcessors() {
diff --git a/core/libs/prx/libSceAgcDriver/Execution/src/Driver/Synchronization/WaitMemory.cpp b/core/libs/prx/libSceAgcDriver/Execution/src/Driver/Synchronization/WaitMemory.cpp
index f1b7df175..3e27604b3 100644
--- a/core/libs/prx/libSceAgcDriver/Execution/src/Driver/Synchronization/WaitMemory.cpp
+++ b/core/libs/prx/libSceAgcDriver/Execution/src/Driver/Synchronization/WaitMemory.cpp
@@ -13,7 +13,7 @@
 #ifdef _WIN32
 #include <windows.h>
 #endif
-#include <immintrin.h>
+#include "prx/libc/include/PreciseWait.hpp"
 #include <algorithm>
 #include <tuple>
 #include <vector>
@@ -344,7 +344,7 @@ void Driver::waitMemory(std::span<const std::uint32_t> packet, std::uint32_t que
         }
         ++polls;
         if (spinning) {
-            _mm_pause();
+            PreciseSpinPause();
             if ((polls & 63u) != 0) continue;
             if (std::chrono::steady_clock::now() - spinStart > spinLimit) spinning = false;
         } else if (pauseSpin || polls >= 4000) {
diff --git a/core/libs/prx/libSceAgcDriver/Execution/src/GuestMemory.cpp b/core/libs/prx/libSceAgcDriver/Execution/src/GuestMemory.cpp
index 5e6805a77..fb39cd9f5 100644
--- a/core/libs/prx/libSceAgcDriver/Execution/src/GuestMemory.cpp
+++ b/core/libs/prx/libSceAgcDriver/Execution/src/GuestMemory.cpp
@@ -16,7 +16,9 @@
 #include <atomic>
 #include <algorithm>
 #include <bit>
+#if defined(__SSE2__)
 #include <emmintrin.h>
+#endif
 #include <functional>
 #include <cstdio>
 #include <cstdlib>
@@ -2827,6 +2829,7 @@ void WriteChanged(std::uint64_t address, std::span<const std::byte> current, std
         std::size_t firstChanged = size;
         std::size_t lastChanged = 0;
         std::size_t at = 0;
+#if defined(__SSE2__)
         for (; at + 16 <= size; at += 16) {
             const auto bytes = _mm_loadu_si128(reinterpret_cast<const __m128i*>(current.data() + at));
             const auto same = _mm_cmpeq_epi8(bytes, _mm_loadu_si128(reinterpret_cast<const __m128i*>(original.data() + at)));
@@ -2839,6 +2842,7 @@ void WriteChanged(std::uint64_t address, std::span<const std::byte> current, std
             lastChanged = std::max(lastChanged, at + 32 - static_cast<std::size_t>(std::countl_zero(changed)));
         }
         _mm_sfence();
+#endif
         for (; at < size; ++at) {
             if (current[at] == original[at]) continue;
             destination[at] = current[at];
diff --git a/core/libs/prx/libSceAgcDriver/Graphics/include/SlimMutex.hpp b/core/libs/prx/libSceAgcDriver/Graphics/include/SlimMutex.hpp
index 32de92284..ae5a9c29b 100644
--- a/core/libs/prx/libSceAgcDriver/Graphics/include/SlimMutex.hpp
+++ b/core/libs/prx/libSceAgcDriver/Graphics/include/SlimMutex.hpp
@@ -3,9 +3,7 @@
 
 #include <atomic>
 #include <thread>
-#if defined(__x86_64__) || defined(_M_X64)
-#include <immintrin.h>
-#endif
+#include "prx/libc/include/PreciseWait.hpp"
 
 namespace AgcDriver::Graphics {
 
@@ -21,9 +19,7 @@ public:
             while (locked.load(std::memory_order_relaxed)) {
                 if (spins < 128) {
                     ++spins;
-#if defined(__x86_64__) || defined(_M_X64)
-                    _mm_pause();
-#endif
+                    PreciseSpinPause();
                 } else {
                     std::this_thread::yield();
                 }
diff --git a/core/libs/prx/libc/include/PreciseWait.hpp b/core/libs/prx/libc/include/PreciseWait.hpp
index b18703949..1ab539ebd 100644
--- a/core/libs/prx/libc/include/PreciseWait.hpp
+++ b/core/libs/prx/libc/include/PreciseWait.hpp
@@ -126,6 +126,8 @@ inline void PreciseSleepHundredNanos(unsigned long long hundredNanos) {
 inline void PreciseSpinPause() {
 #if defined(__x86_64__) || defined(_M_X64) || defined(__i386__) || defined(_M_IX86)
     _mm_pause();
+#elif defined(__aarch64__)
+    asm volatile("yield" ::: "memory");
 #else
     std::atomic_signal_fence(std::memory_order_seq_cst);
 #endif
